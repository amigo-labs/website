---
import { latestRelease, versionOf } from '../lib/data.ts';
import { formatDate, href, tx, ui, type Locale } from '../lib/i18n.ts';
import type { Project } from '../lib/schema.ts';
import ProjectIcon from './ProjectIcon.astro';

interface Props {
  project: Project;
  locale: Locale;
  compact?: boolean;
}
const { project: p, locale, compact = false } = Astro.props;
const t = ui(locale);
const r = latestRelease(p);
---

<li class:list={['card', 'project', { compact }]} style={`--accent:${p.accent}`}>
  <div class="head">
    <ProjectIcon project={p} size={compact ? 36 : 48} />
    <div>
      <h3><a href={href(locale, `/${p.slug}/`)}>{p.name}</a></h3>
      <span class:list={['pill', p.status]}>{t.status[p.status]}</span>
    </div>
  </div>
  <p class="tagline">{tx(p.tagline, locale)}</p>
  {!compact && <p class="summary">{tx(p.summary, locale)}</p>}
  <div class="foot">
    {
      p.platforms.length > 0 && (
        <span class="label">{p.platforms.map((x) => t.platforms[x]).join(' · ')}</span>
      )
    }
    {
      r && p.releases.versioned && (
        <span class="label version" title={formatDate(r.date, locale)}>
          v{versionOf(r)}
        </span>
      )
    }
  </div>
</li>

<style>
  .project {
    position: relative;
    padding: 24px;
    display: grid;
    gap: 12px;
    grid-template-rows: auto auto 1fr auto;
    transition: border-color 0.15s, transform 0.15s;
    overflow: hidden;
  }
  .project::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--accent);
  }
  .project:hover {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
    transform: translateY(-2px);
  }
  .compact {
    grid-template-rows: auto 1fr auto;
    padding: 20px;
  }
  .compact::before {
    opacity: 0.45;
  }
  .head {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .head > div {
    display: grid;
    gap: 4px;
    justify-items: start;
  }
  h3 {
    font-size: 20px;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tagline {
    font-weight: 550;
    color: var(--text);
  }
  .summary {
    color: var(--text-2);
    font-size: 15px;
  }
  .compact .tagline {
    font-weight: 450;
    color: var(--text-2);
    font-size: 15px;
  }
  .version {
    text-transform: none;
    color: var(--text-2);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
</style>
