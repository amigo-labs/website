---
// The amigo-labs pixel "A" (public/brand/, from the logo artwork).
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<img class="logo" src="/brand/icon-64.png" width={size} height={size} alt="" />

<style>
  .logo {
    border-radius: 6px;
    image-rendering: auto;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--glow) 35%, transparent), 0 0 12px -2px color-mix(in oklab, var(--glow) 55%, transparent);
  }
</style>
