---
// The amigo-labs mark: four tiles, one lit in the brand color.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect x="3" y="3" width="12" height="12" rx="3" fill="currentColor"></rect>
  <rect x="17" y="3" width="12" height="12" rx="3" fill="currentColor" opacity=".4"></rect>
  <rect x="3" y="17" width="12" height="12" rx="3" fill="currentColor" opacity=".4"></rect>
  <rect x="17" y="17" width="12" height="12" rx="3" fill="var(--brand)"></rect>
</svg>
