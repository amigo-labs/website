---
// A project's mark: its pixel monogram in its accent colour (src/lib/monogram.ts).
import { monogramSvg } from '../lib/monogram.ts';
import type { Project } from '../lib/schema.ts';

interface Props {
  project: Project;
  size?: number;
}
const { project, size = 48 } = Astro.props;
const svg = monogramSvg(project.monogram, project.accent);
---

<span class="mark" style={`width:${size}px;height:${size}px`} aria-hidden="true" set:html={svg} />

<style>
  .mark {
    display: inline-block;
    flex: none;
    image-rendering: pixelated;
  }
  .mark :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
