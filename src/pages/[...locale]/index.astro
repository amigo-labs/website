---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectIcon from '../../components/ProjectIcon.astro';
import { allReleases, isShipping, projects, versionOf } from '../../lib/data.ts';
import { formatDate, href, localeFromParam, localeParams, ui } from '../../lib/i18n.ts';

export function getStaticPaths() {
  return localeParams.map((params) => ({ params }));
}

const locale = localeFromParam(Astro.params.locale);
const t = ui(locale);
const all = projects();
const shipping = all.filter(isShipping);
const upcoming = all.filter((p) => !isShipping(p));
const recent = allReleases()
  .filter((x) => !x.release.prerelease)
  .slice(0, 6);
---

<Base locale={locale} title={`${t.siteName} — ${t.siteTagline}`} description={t.siteIntro} path="/">
  <section class="hero">
    <div class="wrap">
      <div class="emblem">
        <picture>
          <source type="image/webp" srcset="/brand/amigo-labs-480.webp 480w, /brand/amigo-labs-800.webp 800w" sizes="(max-width: 520px) 78vw, 420px" />
          <img src="/brand/amigo-labs-800.png" width="800" height="800" alt={t.logoAlt} fetchpriority="high" />
        </picture>
      </div>
      <p class="label">{t.siteName}</p>
      <h1>{t.siteTagline}</h1>
      <p class="intro">{t.siteIntro}</p>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="projects">
    <h2 id="projects" class="label">{t.projects}</h2>
    <ul class="cards">
      {shipping.map((p) => <ProjectCard project={p} locale={locale} />)}
    </ul>
  </section>

  {
    upcoming.length > 0 && (
      <section class="wrap block" aria-labelledby="upcoming">
        <h2 id="upcoming" class="label">{t.inDevelopment}</h2>
        <ul class="cards small">
          {upcoming.map((p) => (
            <ProjectCard project={p} locale={locale} compact />
          ))}
        </ul>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="wrap block" aria-labelledby="releases">
        <div class="row">
          <h2 id="releases" class="label">{t.allReleases}</h2>
          <a href={href(locale, '/releases/')}>{t.olderReleases} →</a>
        </div>
        <ol class="feed card">
          {recent.map(({ project: p, release: r }) => (
            <li style={`--accent:${p.accent}`}>
              <a href={href(locale, `/${p.slug}/releases/#${encodeURIComponent(r.tag)}`)}>
                <ProjectIcon project={p} size={22} />
                <span class="name">{p.name}</span>
                <span class="ver">{p.releases.versioned ? versionOf(r) : r.name}</span>
                <time datetime={r.date}>{formatDate(r.date, locale)}</time>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  /* The night band around the logo stays dark in both themes. */
  .hero {
    --text: #eef1f8;
    --text-2: #b7c0d6;
    --muted: #8592b0;
    position: relative;
    overflow: hidden;
    color: var(--text);
    padding-block: clamp(40px, 7vw, 80px) clamp(48px, 8vw, 88px);
    margin-bottom: clamp(32px, 5vw, 56px);
    background:
      radial-gradient(1.5px 1.5px at 12% 22%, #f5e554 98%, transparent),
      radial-gradient(1.5px 1.5px at 84% 16%, #2fb0d0 98%, transparent),
      radial-gradient(2px 2px at 73% 64%, #f5e554 98%, transparent),
      radial-gradient(1.5px 1.5px at 22% 74%, #5be3a0 98%, transparent),
      radial-gradient(1.5px 1.5px at 92% 82%, #eef1f8 98%, transparent),
      radial-gradient(1.5px 1.5px at 6% 52%, #eef1f8 98%, transparent),
      radial-gradient(ellipse 55% 60% at 50% 34%, color-mix(in oklab, var(--glow) 22%, transparent), transparent 70%),
      var(--night);
    border-bottom: 1px solid color-mix(in oklab, var(--glow) 25%, transparent);
  }
  .hero .wrap {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
  }
  .emblem {
    width: min(420px, 78vw);
    margin-bottom: 12px;
    animation: hover 7s ease-in-out infinite;
  }
  /* The artwork's own background is the night blue of this band: fading its
     square edge lets the letter float in the sky instead of sitting on a card. */
  .emblem img {
    width: 100%;
    height: auto;
    --fade: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-image: var(--fade), linear-gradient(to bottom, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: var(--fade), linear-gradient(to bottom, transparent, #000 4%, #000 96%, transparent);
    mask-composite: intersect;
  }
  @keyframes hover {
    50% {
      transform: translateY(-8px);
    }
  }
  .hero .label {
    color: #f5e554;
  }
  h1 {
    font-size: clamp(32px, 5.4vw, 58px);
    max-width: 20ch;
    letter-spacing: -0.035em;
  }
  .intro {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--text-2);
    max-width: 56ch;
  }
  .block {
    display: grid;
    gap: 18px;
    padding-bottom: clamp(40px, 6vw, 64px);
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: 16px;
  }
  .cards.small {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .row a {
    font-size: 14px;
    color: var(--text-2);
  }
  .feed {
    list-style: none;
    margin: 0;
    padding: 6px;
  }
  .feed a {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .feed a:hover {
    background: var(--surface-2);
  }
  .name {
    font-weight: 550;
  }
  .ver {
    font: 14px var(--mono);
    color: var(--text-2);
  }
  time {
    font-size: 14px;
    color: var(--muted);
    min-width: 9.5em;
    text-align: right;
  }
  @media (max-width: 560px) {
    .feed a {
      grid-template-columns: 22px 1fr auto;
    }
    time {
      grid-column: 2 / -1;
      text-align: left;
      min-width: 0;
    }
  }
</style>
